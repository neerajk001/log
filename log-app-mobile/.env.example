EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
# Dev builds auto-detect the backend from Metro's dev-server host (same LAN IP,
# port 4000) — no need to set this locally. Release/EAS builds must set the
# public HTTPS API URL (see eas.json).
EXPO_PUBLIC_API_BASE_URL=https://api.example.com
# Product analytics (read by app/_layout.tsx; empty/missing disables tracking).
EXPO_PUBLIC_POSTHOG_API_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
