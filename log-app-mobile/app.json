{
  "expo": {
    "name": "Repora",
    "slug": "log",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "log",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0A0A0B",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "package": "com.neerajkk01.log"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splashscreen.png",
          "resizeMode": "cover",
          "backgroundColor": "#0A0A0A",
          "dark": {
            "backgroundColor": "#0A0A0A"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Repora uses your photos so you can add a meal or a check-in picture.",
          "cameraPermission": "Repora uses the camera so you can snap a meal or a check-in photo."
        }
      ],
      "expo-localization",
      "posthog-react-native/expo"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/3bfb27fd-c1f4-4e52-9849-956c9c7767ea"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "3bfb27fd-c1f4-4e52-9849-956c9c7767ea"
      }
    }
  }
}
