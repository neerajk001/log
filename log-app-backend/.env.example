DATABASE_URL=postgresql://user:password@host:5432/log?sslmode=require
# Local dev only, never in production: DATABASE_SSL_NO_VERIFY=true
CLERK_SECRET_KEY=sk_test_xxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxx
OPENAI_API_KEY=xxxxxxxx
OPENAI_MODEL=gpt-4.1-mini

# --- Coach chat + meal provider (any OpenAI-Responses-compatible endpoint) ---
# Leave AI_BASE_URL unset to use OpenAI. Example: Command Code + DeepSeek Flash:
#   AI_BASE_URL=https://api.commandcode.ai/provider/v1
#   AI_RESPONSE_CHAINING=false     (provider does not store responses — every tool
#                                   round then replays the conversation, so the input
#                                   bill is rounds x (context + history))
#   AI_PROMPT_CACHE=false
#   AI_THINKING=disabled           (skip reasoning tokens on reasoning models)
#   COACH_FAST_MODEL=deepseek/deepseek-v4-flash
#   COACH_MODEL=deepseek/deepseek-v4-flash
#   COACH_MEAL_MODEL=deepseek/deepseek-v4-flash              (meal text / chat agent)
#   COACH_MEAL_VISION_MODEL=deepseek/deepseek-v4-flash-vision-exp   (meal photos)
#   COACH_PHYSIQUE_MODEL=deepseek/deepseek-v4-flash-vision-exp      (body photo read)
# AI_API_KEY falls back to COMMANDCODE_API_KEY then OPENAI_API_KEY.
AI_BASE_URL=
AI_API_KEY=
AI_RESPONSE_CHAINING=
AI_PROMPT_CACHE=
AI_THINKING=
# The final answer's token ceiling (default 400). The style prompt asks for ~100 words,
# so a few hundred is plenty — a bigger number only buys long-winded replies at cost.
AI_REPLY_TOKENS=
# Ceiling for rounds that emit tool calls (default 1600): they have to fit the call's
# arguments, e.g. a day's exercises or a meal's items.
AI_TOOL_TOKENS=
# Tool rounds per turn (1-8, default 4). With chaining off, every round replays the
# context and history, so this multiplies the input bill on a hard question.
AI_TOOL_ROUNDS=
# Previous messages replayed per turn (2-24, default 8). Each one is re-sent on
# every tool round, so this is the biggest single lever on chat cost.
AI_HISTORY_TURNS=
OPENAI_PARSE_MODEL=
COACH_FAST_MODEL=
COACH_MODEL=
# Physique photo analysis — vision-capable, on the meal provider (not OpenAI).
# Only the written read is kept, never the image.
COACH_PHYSIQUE_MODEL=
# Meal text / the Meals chat agent. A plain text model is fine here.
COACH_MEAL_MODEL=
# Meal PHOTOS. Must be vision-capable: a text-only model accepts the request and
# silently returns nothing for an image.
COACH_MEAL_VISION_MODEL=

# --- Food lookup (meal agent) ---
# Open Food Facts is used first (free, no key). On a miss, a web search runs if
# a key is set (Tavily). Leave the key empty for Open Food Facts only.
TAVILY_API_KEY=
# Optional. Sent as the User-Agent for Open Food Facts requests.
OFF_USER_AGENT=
PORT=3000
NODE_ENV=development
# Comma-separated exact origins allowed for browser CORS. Empty = deny all
# browser cross-origin (native mobile still works). Include Expo web dev
# origins for local web testing, e.g. http://localhost:8081.
CORS_ALLOWED_ORIGINS=
# Optional. Without it the API runs fine but reports no errors anywhere.
# Set on the VPS to enable Sentry error monitoring (server-side only).
SENTRY_DSN=
# Optional. Defaults to NODE_ENV.
SENTRY_ENVIRONMENT=
